---
import "leaflet/dist/leaflet.css";

import { getWalkingStages, getCaminoSummary } from "@utils/caminoStages";

const availableStages = getWalkingStages();

const summary = getCaminoSummary();
---

<div class="camino-map-wrapper">
  <div class="map-toolbar">
    <div>
      <strong> My Camino Route </strong>

      <span>
        {summary.totalRouteDistance.toFixed(1)}
        km route ·
        {summary.totalGpxDistance.toFixed(1)}
        km Garmin ·
        {summary.walkingDays}
        walking days
      </span>
    </div>

    <button id="camino-reset-map" type="button" class="map-reset-button">
      Show full route
    </button>
  </div>

  <div
    id="camino-map"
    data-stages={JSON.stringify(availableStages)}
    data-route-distance={summary.totalRouteDistance.toFixed(1)}
    data-gpx-distance={summary.totalGpxDistance.toFixed(1)}
    data-walking-days={summary.walkingDays}
  >
  </div>

  <div id="camino-stage-info" class="stage-info">
    <strong> Select a walking stage </strong>

    <span> Hover over a route to identify it, then click to zoom in. </span>
  </div>
</div>

<script>
  import L from "leaflet";

  type Coordinate = [number, number];

  type Stage = {
    id: string;
    day: string;
    route: string;

    from: string;
    to: string;

    routeDistance: number;
    routeCumulative: number;

    gpxDistance: number;
    gpxCumulative: number;

    section: "frances" | "finisterre";

    gpx: string;
  };

  type StageEndpoint = {
    stage: Stage;
    start: Coordinate;
    end: Coordinate;
  };

  type RouteEntry = {
    stage: Stage;
    layer: L.Polyline;
    hitLayer: L.Polyline;
  };

  const mapElement = document.querySelector<HTMLElement>("#camino-map");

  const infoElement = document.querySelector<HTMLElement>("#camino-stage-info");

  const resetButton =
    document.querySelector<HTMLButtonElement>("#camino-reset-map");

  /*
   * =======================================================
   * STAGE INFORMATION CARD
   * =======================================================
   */

  function showStageInfo(stage: Stage) {
    if (!infoElement) {
      return;
    }

    infoElement.innerHTML = `
      <div class="stage-info-heading">
        <span class="stage-badge">
          ${stage.day}
        </span>

        <strong>
          ${stage.from} → ${stage.to}
        </strong>
      </div>

      <span>
        Route:
        ${stage.routeDistance.toFixed(1)} km
        ·
        Garmin:
        ${stage.gpxDistance.toFixed(1)} km
      </span>

      <span>
        Route cumulative:
        ${stage.routeCumulative.toFixed(1)} km
        ·
        Garmin cumulative:
        ${stage.gpxCumulative.toFixed(1)} km
      </span>

      <a href="#${stage.id}">
        Read ${stage.day} ↓
      </a>
    `;
  }

  /*
   * =======================================================
   * GPX LOADING
   *
   * GPX distance has already been
   * calculated by Astro.
   *
   * The browser loads coordinates
   * only to draw the route.
   * =======================================================
   */

  async function loadGpxPoints(url: string): Promise<Coordinate[]> {
    const response = await fetch(url);

    if (!response.ok) {
      throw new Error(`Failed to load GPX: ${url}`);
    }

    const gpxText = await response.text();

    const parser = new DOMParser();

    const xml = parser.parseFromString(gpxText, "application/xml");

    if (xml.querySelector("parsererror")) {
      throw new Error(`Invalid GPX XML: ${url}`);
    }

    const trackPoints = xml.querySelectorAll("trkpt");

    return Array.from(trackPoints)
      .map(point => {
        const lat = Number(point.getAttribute("lat"));

        const lon = Number(point.getAttribute("lon"));

        return [lat, lon] as Coordinate;
      })
      .filter(([lat, lon]) => Number.isFinite(lat) && Number.isFinite(lon));
  }

  /*
   * =======================================================
   * MARKERS
   * =======================================================
   */

  function createMarkerIcon(type: "start" | "stop" | "end") {
    return L.divIcon({
      className: "camino-marker-wrapper",

      html: `
        <div class="camino-marker ${type}">
          <div class="camino-marker-dot"></div>
        </div>
      `,

      iconSize: [30, 40],

      iconAnchor: [15, 38],

      popupAnchor: [0, -35],
    });
  }

  function createStartMarker(
    point: Coordinate,
    stage: Stage,
    onSelect: () => void
  ) {
    const marker = L.marker(point, {
      icon: createMarkerIcon("start"),
    });

    marker.bindPopup(`
      <strong>
        ${stage.from}
      </strong>
      <br>
      Camino start · ${stage.day}
    `);

    marker.on("click", onSelect);

    return marker;
  }

  function createStopMarker(
    point: Coordinate,
    currentStage: Stage,
    nextStage: Stage,
    onSelect: () => void
  ) {
    const marker = L.marker(point, {
      icon: createMarkerIcon("stop"),
    });

    marker.bindPopup(`
      <strong>
        ${currentStage.to}
      </strong>
      <br>
      ${currentStage.day} end ·
      ${nextStage.day} start
    `);

    marker.on("click", onSelect);

    return marker;
  }

  function createEndMarker(
    point: Coordinate,
    stage: Stage,
    onSelect: () => void
  ) {
    const marker = L.marker(point, {
      icon: createMarkerIcon("end"),
    });

    marker.bindPopup(`
      <strong>
        ${stage.to}
      </strong>
      <br>
      Camino complete · ${stage.day}
    `);

    marker.on("click", onSelect);

    return marker;
  }

  /*
   * =======================================================
   * MAP
   * =======================================================
   */

  if (mapElement) {
    const stages: Stage[] = JSON.parse(mapElement.dataset.stages ?? "[]");

    const routeDistance = mapElement.dataset.routeDistance ?? "0.0";

    const gpxDistance = mapElement.dataset.gpxDistance ?? "0.0";

    const walkingDays = mapElement.dataset.walkingDays ?? "0";

    const map = L.map(mapElement, {
      scrollWheelZoom: true,

      preferCanvas: true,
    });

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);

    const routeRenderer = L.canvas({
      padding: 0.5,
    });

    const stageColors = ["#2563eb", "#f97316"];

    const allRoutePoints: Coordinate[] = [];

    const stageEndpoints: StageEndpoint[] = [];

    const routes: RouteEntry[] = [];

    let selectedRoute: RouteEntry | null = null;

    function resetSelectedStyle() {
      if (!selectedRoute) {
        return;
      }

      selectedRoute.layer.setStyle({
        weight: 5,
        opacity: 0.9,
      });
    }

    function selectStage(route: RouteEntry) {
      resetSelectedStyle();

      route.layer.setStyle({
        weight: 8,
        opacity: 1,
      });

      selectedRoute = route;

      showStageInfo(route.stage);

      map.flyToBounds(route.layer.getBounds(), {
        padding: [70, 70],

        maxZoom: 12,

        duration: 0.8,
      });
    }

    /*
     * =====================================================
     * DRAW ROUTES
     * =====================================================
     */

    for (let index = 0; index < stages.length; index++) {
      const stage = stages[index];

      try {
        const points = await loadGpxPoints(stage.gpx);

        if (points.length < 2) {
          continue;
        }

        allRoutePoints.push(...points);

        const color = stageColors[index % stageColors.length];

        const layer = L.polyline(points, {
          renderer: routeRenderer,

          color,

          weight: 5,

          opacity: 0.9,

          interactive: false,

          lineCap: "round",

          lineJoin: "round",
        }).addTo(map);

        const hitLayer = L.polyline(points, {
          renderer: routeRenderer,

          color: "#000000",

          weight: 22,

          opacity: 0,

          interactive: true,

          lineCap: "round",

          lineJoin: "round",
        }).addTo(map);

        const route: RouteEntry = {
          stage,
          layer,
          hitLayer,
        };

        routes.push(route);

        hitLayer.bindTooltip(
          `
            <strong>
              ${stage.day}
            </strong>

            <br>

            ${stage.from} →
            ${stage.to}

            <br>

            Route:
            ${stage.routeDistance.toFixed(1)} km

            <br>

            Garmin:
            ${stage.gpxDistance.toFixed(1)} km
          `,
          {
            sticky: true,

            direction: "top",

            opacity: 0.95,
          }
        );

        hitLayer.on("mouseover", () => {
          mapElement.style.cursor = "pointer";
        });

        hitLayer.on("mouseout", () => {
          mapElement.style.cursor = "";
        });

        hitLayer.on("click", () => {
          selectStage(route);
        });

        stageEndpoints.push({
          stage,

          start: points[0],

          end: points[points.length - 1],
        });
      } catch (error) {
        console.error(`Could not load ${stage.day}`, error);
      }
    }

    /*
     * =====================================================
     * MARKERS
     * =====================================================
     */

    if (stageEndpoints.length > 0) {
      const first = stageEndpoints[0];

      const firstRoute = routes[0];

      createStartMarker(first.start, first.stage, () => {
        if (firstRoute) {
          selectStage(firstRoute);
        }
      }).addTo(map);

      for (let index = 0; index < stageEndpoints.length - 1; index++) {
        const current = stageEndpoints[index];

        const next = stageEndpoints[index + 1];

        const midpoint: Coordinate = [
          (current.end[0] + next.start[0]) / 2,

          (current.end[1] + next.start[1]) / 2,
        ];

        const relatedRoute = routes[index];

        createStopMarker(midpoint, current.stage, next.stage, () => {
          if (relatedRoute) {
            selectStage(relatedRoute);
          }
        }).addTo(map);
      }

      const last = stageEndpoints[stageEndpoints.length - 1];

      const lastRoute = routes[routes.length - 1];

      createEndMarker(last.end, last.stage, () => {
        if (lastRoute) {
          selectStage(lastRoute);
        }
      }).addTo(map);
    }

    /*
     * =====================================================
     * FULL ROUTE
     * =====================================================
     */

    function showFullRoute() {
      resetSelectedStyle();

      selectedRoute = null;

      if (allRoutePoints.length === 0) {
        return;
      }

      map.fitBounds(allRoutePoints, {
        padding: [35, 35],
      });

      if (infoElement) {
        infoElement.innerHTML = `
          <strong>
            My Camino Route
          </strong>

          <span>
            Camino route:
            ${routeDistance} km
            ·
            Garmin recorded:
            ${gpxDistance} km
          </span>

          <span>
            ${walkingDays} walking days ·
            Saint-Jean-Pied-de-Port → Muxía
          </span>
        `;
      }
    }

    showFullRoute();

    resetButton?.addEventListener("click", showFullRoute);
  }
</script>

<style>
  .camino-map-wrapper {
    margin: 2.5rem 0;
  }

  .map-toolbar {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 1rem;

    margin-bottom: 0.75rem;
  }

  .map-toolbar > div {
    display: flex;

    flex-direction: column;

    gap: 0.15rem;
  }

  .map-toolbar strong {
    font-size: 1.1rem;
  }

  .map-toolbar span {
    font-size: 0.9rem;

    opacity: 0.7;
  }

  .map-reset-button {
    flex-shrink: 0;

    padding: 0.45rem 0.8rem;

    border: 1px solid rgb(148 163 184 / 60%);

    border-radius: 8px;

    font-size: 0.85rem;

    font-weight: 600;

    cursor: pointer;

    background: transparent;

    transition: opacity 0.15s ease;
  }

  .map-reset-button:hover {
    opacity: 0.7;
  }

  #camino-map {
    width: 100%;

    height: 550px;

    border: 1px solid rgb(148 163 184 / 50%);

    border-radius: 14px;

    overflow: hidden;
  }

  :global(.camino-marker-wrapper) {
    background: transparent;

    border: none;
  }

  :global(.camino-marker) {
    position: relative;

    width: 28px;

    height: 28px;

    border-radius: 50% 50% 50% 0;

    transform: rotate(-45deg);

    border: 3px solid white;

    box-shadow: 0 2px 6px rgb(0 0 0 / 35%);
  }

  :global(.camino-marker.start) {
    background: #16a34a;
  }

  :global(.camino-marker.stop) {
    background: #2563eb;
  }

  :global(.camino-marker.end) {
    background: #dc2626;
  }

  :global(.camino-marker-dot) {
    position: absolute;

    width: 8px;

    height: 8px;

    top: 7px;

    left: 7px;

    border-radius: 50%;

    background: white;

    transform: rotate(45deg);
  }

  :global(.leaflet-tooltip) {
    border: none;

    border-radius: 8px;

    padding: 0.45rem 0.6rem;

    box-shadow: 0 2px 8px rgb(0 0 0 / 15%);

    font-size: 0.8rem;

    line-height: 1.35;
  }

  .stage-info {
    display: flex;

    flex-direction: column;

    gap: 0.4rem;

    margin-top: 0.85rem;

    padding: 1rem;

    border: 1px solid rgb(148 163 184 / 55%);

    border-radius: 10px;
  }

  :global(.stage-info-heading) {
    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap: 0.5rem;
  }

  :global(.stage-badge) {
    display: inline-flex;

    align-items: center;

    padding: 0.15rem 0.45rem;

    border-radius: 6px;

    background: rgb(37 99 235 / 12%);

    font-size: 0.8rem;

    font-weight: 700;
  }

  .stage-info strong {
    font-size: 1.02rem;
  }

  .stage-info span {
    opacity: 0.8;
  }

  .stage-info a {
    width: fit-content;

    margin-top: 0.25rem;

    font-weight: 600;

    text-decoration: underline;
  }

  @media (max-width: 640px) {
    #camino-map {
      height: 400px;
    }

    .map-toolbar {
      align-items: flex-start;
    }

    .map-reset-button {
      font-size: 0.75rem;

      padding: 0.4rem 0.6rem;
    }

    .stage-info {
      font-size: 0.9rem;
    }
  }
</style>
