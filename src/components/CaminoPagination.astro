---
interface Props {
  currentPage: number;
  totalPages: number;
  slug: string;
  currentLabel?: string;
}

const { currentPage, totalPages, slug, currentLabel } = Astro.props;

function getPageUrl(page: number) {
  if (page === 1) {
    return `/posts/${slug}/`;
  }

  return `/posts/${slug}/page/${page}/`;
}

const previousPage = currentPage > 1 ? currentPage - 1 : null;

const nextPage = currentPage < totalPages ? currentPage + 1 : null;
---

<nav class="camino-pagination" aria-label="Camino journey pages">
  <div class="pagination-side pagination-left">
    {
      previousPage ? (
        <a href={getPageUrl(previousPage)} class="pagination-link" rel="prev">
          <span class="arrow">←</span>

          <span class="link-content">
            <small>Previous</small>
            <strong>Page {previousPage}</strong>
          </span>
        </a>
      ) : (
        <span />
      )
    }
  </div>

  <div class="pagination-current">
    {currentLabel && <strong>{currentLabel}</strong>}

    <span>
      Page {currentPage} of {totalPages}
    </span>
  </div>

  <div class="pagination-side pagination-right">
    {
      nextPage ? (
        <a href={getPageUrl(nextPage)} class="pagination-link" rel="next">
          <span class="link-content">
            <small>Next</small>
            <strong>Page {nextPage}</strong>
          </span>

          <span class="arrow">→</span>
        </a>
      ) : (
        <span />
      )
    }
  </div>
</nav>

<style>
  .camino-pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;

    margin: 2rem 0 1rem;
    padding-top: 0.5rem;
  }

  .pagination-side {
    min-width: 0;
  }

  .pagination-right {
    display: flex;
    justify-content: flex-end;
  }

  .pagination-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;

    text-decoration: none;
  }

  .pagination-link:hover strong {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .link-content {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .pagination-right .link-content {
    text-align: right;
  }

  .link-content small {
    font-size: 0.72rem;
    opacity: 0.6;
  }

  .link-content strong {
    font-size: 0.9rem;
  }

  .arrow {
    font-size: 1.25rem;
  }

  .pagination-current {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;

    text-align: center;
  }

  .pagination-current strong {
    font-size: 0.85rem;
  }

  .pagination-current span {
    font-size: 0.75rem;
    opacity: 0.6;
  }

  @media (max-width: 640px) {
    .camino-pagination {
      grid-template-columns: 1fr 1fr;
    }

    .pagination-current {
      grid-column: 1 / -1;
      grid-row: 1;

      margin-bottom: 0.5rem;
    }

    .pagination-left {
      grid-column: 1;
    }

    .pagination-right {
      grid-column: 2;
    }
  }
</style>
