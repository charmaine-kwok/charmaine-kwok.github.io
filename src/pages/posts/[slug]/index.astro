---
import { type CollectionEntry, getCollection } from "astro:content";
import Posts from "@layouts/Posts.astro";
import PostDetails from "@layouts/PostDetails.astro";
import getSortedPosts from "@utils/getSortedPosts";
import getPageNumbers from "@utils/getPageNumbers";
import getPagination from "@utils/getPagination";
import CaminoRouteMap from "@components/CaminoRouteMap.astro";
import CaminoStageTable from "@components/CaminoStageTable.astro";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import CaminoPagination from "@components/CaminoPagination.astro";
import { getCaminoPages } from "@utils/caminoPagination";

export interface Props {
  post: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  const postResult = posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));

  const pagePaths = getPageNumbers(posts.length).map(pageNum => ({
    params: { slug: String(pageNum) },
  }));

  return [...postResult, ...pagePaths];
}

const { slug } = Astro.params;
const { post } = Astro.props;

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);

const pagination = getPagination({
  posts: sortedPosts,
  page: slug,
});

const isJourneyPost = post?.slug === "camino-frances-journey";

const isAlberguePost = post?.slug === "camino-frances-albergue";

const isCaminoPost = isJourneyPost || isAlberguePost;

let caminoBeforeHtml = "";
let caminoAfterHtml = "";
let caminoTotalPages = 1;

if (isCaminoPost && post) {
  const splitPattern = /(?=## SECTION 2\b)/;

  const parts = post.body.split(splitPattern);

  const beforeMarkdown = parts[0] ?? "";

  const caminoPages = getCaminoPages(post.body);

  caminoTotalPages = caminoPages.length;

  const afterMarkdown =
    caminoPages.find(page => page.page === 1)?.markdown ?? "";

  const processor = await createMarkdownProcessor();

  const beforeRendered = await processor.render(beforeMarkdown);
  const afterRendered = await processor.render(afterMarkdown);

  caminoBeforeHtml = beforeRendered.code;
  caminoAfterHtml = afterRendered.code;
}
---

{
  post ? (
    isCaminoPost ? (
      <PostDetails
        post={post}
        beforeHtml={caminoBeforeHtml}
        afterHtml={caminoAfterHtml}
      >
        <div slot="between-content">
          <CaminoStageTable
            showAccommodation={isAlberguePost}
            showGarmin={!isAlberguePost}
            slug={post.slug}
            paginated={true}
          />

          <CaminoRouteMap />
        </div>

        <div slot="after-content">
          <CaminoPagination
            currentPage={1}
            totalPages={caminoTotalPages}
            slug={post.slug}
            currentLabel="Days 0–10"
          />
        </div>
      </PostDetails>
    ) : (
      <PostDetails post={post} />
    )
  ) : (
    <Posts {...pagination} />
  )
}
